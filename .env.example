# Supabase Postgres connection (Transaction pooler, port 6543).
# Dashboard: Project → Database → Connection string → Transaction pooler.
# The transaction pooler is required for serverless route handlers, and the app
# disables prepared statements to match it (see lib/db/index.ts).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
